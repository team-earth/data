        hierarchyFile: path.join(DATA_ROOT, 'ottawa-resilient-to-extremism', 'hierarchy.json'),
        contactFile: path.join(DATA_ROOT, 'ottawa-resilient-to-extremism', 'contacts.json')
    },
    'mental-health-nova-scotia': {
